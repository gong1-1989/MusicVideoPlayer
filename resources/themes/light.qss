/* ============================================================
   主题：轻快明亮梦幻（bright dream）
   晨曦渐变底（淡紫 → 薄荷蓝 → 蜜桃粉）+ 白玻璃面板 + 紫青粉强调
   ============================================================ */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #2b2b45;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0    #f7f4ff,
                                stop:0.3  #efe9ff,
                                stop:0.62 #e8f3ff,
                                stop:0.85 #fdf0fb,
                                stop:1    #fff9f2);
}

QWidget#centralwidget {
    background: transparent;
}

/* ------------------------------------------------ 白玻璃面板 */
QFrame#panelSidebar,
QFrame#panelStage,
QFrame#panelTransport {
    background: rgba(255, 255, 255, 72%);
    border: 1px solid rgba(140, 130, 220, 22%);
    border-radius: 18px;
}

QFrame#panelStage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffffff,
                                stop:1 #f1eeff);
    border: 1px solid rgba(140, 150, 235, 30%);
}

/* 侧栏做成浮层时压在画面上，底色要更实才看得清；回布局时保持原来的淡玻璃 */
QFrame#panelSidebar[floating="true"] {
    background: rgba(253, 252, 255, 92%);
}

/* 搜索分页条与结果列表分开，避免最后一行贴着翻页按钮像被压住 */
QFrame#frame_searchPager {
    border: none;
    border-top: 1px solid rgba(140, 130, 220, 18%);
    background: transparent;
}

QFrame#panelTransport {
    background: rgba(255, 255, 255, 85%);
    border: 1px solid rgba(140, 130, 220, 22%);
}

/* 全屏时控制条压在视频上，底色要比普通浮层更实，保证文字和进度条可读 */
QFrame#panelTransport[fullscreen="true"] {
    background: rgba(248, 247, 255, 95%);
    border: 1px solid rgba(140, 130, 220, 38%);
    border-radius: 18px;
}

/* ------------------------------------------------ 文字层级 */

QFrame#brandLine {
    border: none;
    border-radius: 1px;
    min-height: 2px;
    max-height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0    rgba(106, 75, 255, 85%),
                                stop:0.45 rgba(255, 138, 199, 80%),
                                stop:1    rgba(106, 75, 255, 0%));
}

QLabel#label_searchTitle,
QLabel#label_playlistTitle {
    color: rgba(43, 43, 69, 45%);
    font-size: 12px;
    padding-left: 4px;
}

QLabel#label_status {
    color: rgba(43, 43, 69, 80%);
    font-size: 12px;
}

QLabel#label_time {
    color: rgba(70, 80, 160, 85%);
    font-size: 12px;
}

QLabel#label_volume {
    color: rgba(43, 43, 69, 45%);
    font-size: 12px;
}

/* ------------------------------------------------ 输入类 */
QLineEdit#edit_search {
    background: rgba(255, 255, 255, 90%);
    border: 1px solid rgba(140, 130, 220, 30%);
    border-radius: 19px;
    padding: 4px 14px;
    color: #2b2b45;
    selection-background-color: #7b5bff;
    selection-color: #ffffff;
}

QLineEdit#edit_search:hover {
    border: 1px solid rgba(140, 130, 220, 55%);
}

QLineEdit#edit_search:focus {
    background: #ffffff;
    border: 1px solid rgba(106, 75, 255, 70%);
}

QComboBox {
    background: rgba(255, 255, 255, 92%);
    border: 1px solid rgba(140, 130, 220, 30%);
    border-radius: 10px;
    padding: 4px 10px;
    min-height: 26px;
    color: #2b2b45;
}

QComboBox:hover {
    border: 1px solid rgba(106, 75, 255, 55%);
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 35%);
    border-radius: 10px;
    padding: 4px;
    color: #2b2b45;
    selection-background-color: rgba(123, 91, 255, 18%);
    selection-color: #2b2b45;
}

/* 下拉弹层上下滚动器默认带浅色底板，会在浅色弹层底部留下色块 */
QComboBoxPrivateScroller {
    background: transparent;
    border: none;
    min-height: 0;
    max-height: 0;
}

QComboBox#combo_searchType,
QComboBox#combo_searchSource,
QComboBox#combo_searchQuality {
    padding: 2px 18px 2px 5px;
    border-radius: 8px;
    min-height: 24px;
}

QComboBox#combo_searchType::drop-down,
QComboBox#combo_searchSource::drop-down,
QComboBox#combo_searchQuality::drop-down {
    width: 16px;
}

QListWidget#list_searchSuggestions {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 40%);
    border-radius: 10px;
    padding: 4px;
    color: #2b2b45;
    outline: none;
    selection-background-color: rgba(123, 91, 255, 18%);
    selection-color: #2b2b45;
}

QListWidget#list_searchSuggestions::item {
    padding: 7px 10px;
    border-radius: 8px;
}

QListWidget#list_searchSuggestions::item:hover,
QListWidget#list_searchSuggestions::item:selected {
    background: rgba(123, 91, 255, 14%);
    color: #1f1f36;
}

/* ------------------------------------------------ 通用按钮 */
QPushButton {
    background: rgba(255, 255, 255, 85%);
    border: 1px solid rgba(140, 130, 220, 28%);
    border-radius: 14px;
    padding: 6px 16px;
    min-height: 26px;
    color: #3a3a58;
}

/* 源管理左侧 4 列紧凑按钮：收窄左右内边距，避免两字标签被裁 */
QPushButton#btn_add,
QPushButton#btn_duplicate,
QPushButton#btn_remove,
QPushButton#btn_addSite,
QPushButton#btn_import,
QPushButton#btn_export,
QPushButton#btn_example,
QPushButton#btn_refresh {
    padding: 2px 4px;
    min-height: 20px;
}

QPushButton:hover {
    background: #ffffff;
    border: 1px solid rgba(106, 75, 255, 55%);
}

QPushButton:pressed {
    background: rgba(123, 91, 255, 12%);
}

QPushButton:disabled {
    color: rgba(43, 43, 69, 35%);
    border-color: rgba(140, 130, 220, 12%);
}

QPushButton#btn_search {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #7b5bff,
                                stop:1 #35c2ff);
    border: 1px solid rgba(255, 255, 255, 70%);
    border-radius: 19px;
    color: #ffffff;
    font-weight: 600;
    padding: 0;
}

/* 搜索翻页按钮改成纯图标，固定紧凑尺寸 */
QPushButton#btn_searchPrev,
QPushButton#btn_searchNext {
    min-width: 30px;
    max-width: 30px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 13px;
    padding: 0;
}

QPushButton#btn_search:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8f75ff,
                                stop:1 #5cd0ff);
}

QWidget#SearchWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #f7f8ff,
                                stop:0.55 #f1f0ff,
                                stop:1 #eef7ff);
    color: #24243a;
}

QLabel#label_searchStatus,
QLabel#label_downloadStatus {
    color: rgba(38, 60, 120, 85%);
    font-size: 12px;
    padding: 2px 4px;
}

QLabel#label_searchHint {
    color: rgba(43, 43, 69, 45%);
    padding: 12px 6px;
}

QPushButton#btn_play {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff9ad5,
                                stop:0.5 #9a7bff,
                                stop:1 #35c2ff);
    border: 1px solid rgba(255, 255, 255, 85%);
    color: #ffffff;
    font-weight: 700;
    padding: 0;
}

QPushButton#btn_play:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffb0e0,
                                stop:0.5 #aa90ff,
                                stop:1 #63d4ff);
}

QPushButton#btn_stop,
QPushButton#btn_mode,
QPushButton#btn_fullscreen,
QPushButton#btn_openSearch,
QPushButton#btn_downloads,
QPushButton#btn_prev,
QPushButton#btn_next,
QPushButton#btn_seekBack,
QPushButton#btn_seekForward {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
}

/* 侧栏底部按钮改成纯图标，固定方形，悬停提示由代码写入 */
QPushButton#btn_settings {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
    color: rgba(43, 43, 69, 65%);
}

/* ------------------------------------------------ 列表 */
QListView,
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    color: #33334f;
}

QListView::item,
QListWidget::item {
    padding: 7px 10px;
    border-radius: 10px;
    margin: 2px 4px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: rgba(123, 91, 255, 10%);
}

QListView::item:selected,
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(123, 91, 255, 22%),
                                stop:1 rgba(53, 194, 255, 14%));
    color: #1e1e33;
}

/* ------------------------------------------------ 自绘容器 */
QWidget#videoStage {
    background: transparent;
}

/* ------------------------------------------------ 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget::tab-bar {
    left: 0;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 70%);
    color: rgba(43, 43, 69, 55%);
    padding: 7px 16px;
    border-radius: 12px;
    margin-right: 6px;
    min-width: 64px;
    border: 1px solid rgba(140, 130, 220, 18%);
}

QTabBar::tab:hover {
    background: #ffffff;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(123, 91, 255, 30%),
                                stop:1 rgba(53, 194, 255, 22%));
    color: #1e1e33;
    border: 1px solid rgba(106, 75, 255, 40%);
}

/* ------------------------------------------------ 滑块 */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(120, 120, 190, 10%);
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #35c2ff);
}

QSlider::add-page:horizontal {
    border-radius: 3px;
    background: rgba(120, 120, 190, 10%);
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid rgba(106, 75, 255, 70%);
}

QSlider#slider_volume::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}

QSlider#slider_volume::handle:horizontal {
    width: 11px;
    height: 11px;
    margin: -4px 0;
    border-radius: 6px;
}

QPushButton#btn_volume {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
}

QFrame#volumePopup {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 98%),
                                stop:1 rgba(238, 242, 255, 98%));
    border: 1px solid rgba(106, 75, 255, 45%);
    border-radius: 16px;
}

QLabel#label_volumeValue {
    color: #3f3a70;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 8px;
    background: rgba(106, 75, 255, 10%);
}

QSlider#slider_volume::groove:vertical {
    width: 8px;
    border-radius: 4px;
    background: rgba(100, 100, 170, 20%);
    border: 1px solid rgba(106, 75, 255, 22%);
}

QSlider#slider_volume::sub-page:vertical {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #35c2ff);
}

QSlider#slider_volume::add-page:vertical {
    border-radius: 4px;
    background: rgba(100, 100, 170, 12%);
}

QSlider#slider_volume::handle:vertical {
    width: 18px;
    height: 18px;
    margin: 0 -6px;
    border-radius: 9px;
    background: #ffffff;
    border: 1px solid rgba(106, 75, 255, 80%);
}

/* ------------------------------------------------ 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(120, 120, 190, 22%);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(106, 75, 255, 40%);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(120, 120, 190, 22%);
    border-radius: 4px;
    min-width: 28px;
}

/* ------------------------------------------------ 菜单 / 提示 / 对话框 */
QMenu {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 30%);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 8px;
    color: #2b2b45;
}

QMenu::item:selected {
    background: rgba(123, 91, 255, 18%);
}

QToolTip {
    background: #ffffff;
    color: #33334f;
    border: 1px solid rgba(140, 130, 220, 35%);
    border-radius: 6px;
    padding: 4px 8px;
}

/* 系统消息框：跟主题底色对齐，避免浅底深字/深底浅字混着来 */
QMessageBox {
    background: #fdfcff;
}

QMessageBox QLabel {
    color: #33334f;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 76px;
    padding: 4px 14px;
}

QDialog#SettingsDialog,
QDialog#SourceManagerDialog,
QDialog#SourceProbeDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fbf9ff,
                                stop:0.55 #f0efff,
                                stop:1 #eaf7ff);
}

/* 外部解析器配置是源管理里的二级弹窗，补齐与源管理一致的浅色底和卡片，
   避免它落回系统默认纯白后与主界面字号/层级不一致。 */
QDialog#SourceParserSettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fbf9ff,
                                stop:0.55 #f0efff,
                                stop:1 #eaf7ff);
}

QDialog#SourceParserSettingsDialog QLabel {
    color: #3a3a58;
    background: transparent;
}

QDialog#SourceParserSettingsDialog QLineEdit {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 28%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #2b2b45;
    selection-background-color: rgba(123, 91, 255, 30%);
}

QDialog#SourceParserSettingsDialog QLineEdit:focus {
    border: 1px solid rgba(123, 91, 255, 65%);
}

QDialog#SourceParserSettingsDialog QFrame#settingsCard {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 20%);
    border-radius: 14px;
}

/* 搜索源管理 / 探源窗口里的表单控件 */
QDialog#SourceManagerDialog QLineEdit,
QDialog#SourceProbeDialog QLineEdit,
QDialog#SourceManagerDialog QPlainTextEdit,
QDialog#SourceProbeDialog QPlainTextEdit,
QDialog#SourceManagerDialog QComboBox,
QDialog#SourceProbeDialog QComboBox {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 28%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #2b2b45;
    selection-background-color: rgba(123, 91, 255, 30%);
}

QDialog#SourceManagerDialog QLineEdit:focus,
QDialog#SourceProbeDialog QLineEdit:focus,
QDialog#SourceManagerDialog QPlainTextEdit:focus,
QDialog#SourceProbeDialog QPlainTextEdit:focus,
QDialog#SourceManagerDialog QComboBox:focus,
QDialog#SourceProbeDialog QComboBox:focus {
    border: 1px solid rgba(123, 91, 255, 65%);
}

QDialog#SourceManagerDialog QGroupBox,
QDialog#SourceProbeDialog QGroupBox {
    border: 1px solid rgba(140, 130, 220, 20%);
    border-radius: 12px;
    margin-top: 14px;
    padding: 6px 8px 4px 8px;
}

QDialog#SourceManagerDialog QGroupBox::title,
QDialog#SourceProbeDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #6a4bff;
}

/* 探源结果表：默认 QTableWidget 会退回系统浅色底，必须显式覆盖表体与表头 */
QDialog#SourceProbeDialog QTableWidget#table_results {
    background: #ffffff;
    alternate-background-color: #f6f4ff;
    border: 1px solid rgba(140, 130, 220, 26%);
    border-radius: 8px;
    color: #2b2b45;
    gridline-color: rgba(140, 130, 220, 18%);
    selection-background-color: rgba(123, 91, 255, 28%);
    selection-color: #2b2b45;
}

QDialog#SourceProbeDialog QTableWidget#table_results::item {
    padding: 4px 6px;
    border: none;
}

QDialog#SourceProbeDialog QHeaderView::section {
    background-color: #f2efff;
    color: #2b2b45;
    border: none;
    border-right: 1px solid rgba(140, 130, 220, 18%);
    border-bottom: 1px solid rgba(140, 130, 220, 28%);
    padding: 5px 6px;
    font-weight: 600;
}

QDialog#SourceProbeDialog QTableCornerButton::section {
    background-color: #f2efff;
    border: none;
}

/* 主操作按钮禁用时不能继续显示成可点击的高亮按钮 */
QPushButton#btn_applyPrimary:disabled {
    background: rgba(140, 130, 220, 10%);
    border: 1px solid rgba(140, 130, 220, 16%);
    color: rgba(43, 43, 69, 45%);
}

QDialog#SourceManagerDialog QCheckBox,
QDialog#SourceProbeDialog QCheckBox {
    color: #2b2b45;
}

QCheckBox {
    color: #2b2b45;
    spacing: 6px;
}

QSpinBox {
    background: rgba(255, 255, 255, 80%);
    border: 1px solid rgba(40, 70, 130, 22%);
    border-radius: 10px;
    padding: 3px 8px;
    min-height: 26px;
    color: #1f2937;
}

QSpinBox:hover {
    border: 1px solid rgba(40, 90, 180, 45%);
}

QDialog#SourceManagerDialog QLabel,
QDialog#SourceProbeDialog QLabel {
    color: #3a3a58;
}

/* 源列表启用了交替行，显式给浅色主题一个淡紫交替底色，避免落回系统默认色 */
QDialog#SourceManagerDialog QListWidget#list_sources {
    alternate-background-color: rgba(123, 91, 255, 6%);
    color: #2b2b45;
}

QDialog#SourceProbeDialog QListWidget {
    background: #ffffff;
    border: 1px solid rgba(140, 130, 220, 20%);
    border-radius: 10px;
    color: #2b2b45;
}

QDialog#SettingsDialog QScrollArea,
QDialog#SourceManagerDialog QScrollArea,
QDialog#SourceProbeDialog QScrollArea {
    background: transparent;
    border: none;
}

/* 滚动容器使用与对话框一致的底色。
   半透明卡片必须叠在不透明底色上才不会被“透明套透明”吃掉边框和背景。 */
QWidget#scroll_widget,
QWidget#scroll_bodyWidget,
QWidget#rightBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fbf9ff,
                                stop:0.55 #f0efff,
                                stop:1 #eaf7ff);
}

QDialog#SettingsDialog QScrollArea QScrollBar:vertical,
QDialog#SourceManagerDialog QScrollArea QScrollBar:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar:vertical {
    background: rgba(140, 130, 220, 8%);
    width: 8px;
    border-radius: 4px;
}

QDialog#SettingsDialog QScrollArea QScrollBar::handle:vertical,
QDialog#SourceManagerDialog QScrollArea QScrollBar::handle:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar::handle:vertical {
    background: rgba(123, 91, 255, 40%);
    border-radius: 4px;
    min-height: 24px;
}

QLabel#label_sectionTitle {
    color: #6a4bff;
    font-size: 13px;
    font-weight: 600;
}

QDialog#SettingsDialog QScrollArea QFrame#settingsCard {
    /* 滚动区里的半透明控件在透明父层上会被吃掉，改用等效的不透明底色 */
    background: #fbfaff;
    border: 1px solid #dcd9f2;
    border-radius: 14px;
}

QLabel#label_hint {
    color: rgba(43, 43, 69, 50%);
    font-size: 12px;
}

QLabel#label_error,
QPlainTextEdit#label_error {
    color: #b03040;
    background: rgba(214, 64, 92, 8%);
    border: 1px solid rgba(214, 64, 92, 20%);
    border-radius: 10px;
    font-size: 12px;
}

QPushButton#btn_applyPrimary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #7b5bff,
                                stop:1 #35c2ff);
    border: 1px solid rgba(255, 255, 255, 70%);
    color: #ffffff;
    font-weight: 600;
    border-radius: 14px;
    padding: 7px 22px;
}

/* 下载管理器：浅色主题下保持同一套玻璃质感 */
QDialog#DownloadManagerDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #f7f8ff,
                                stop:1 #e9f1ff);
    color: #2b2b45;
}
QDialog#DownloadManagerDialog QLabel {
    color: #2b2b45;
    background: transparent;
}
QDialog#DownloadManagerDialog QTreeWidget {
    background: rgba(255, 255, 255, 86%);
    alternate-background-color: rgba(120, 150, 255, 7%);
    border: 1px solid rgba(120, 150, 255, 28%);
    border-radius: 10px;
    color: #2b2b45;
    outline: none;
}
QDialog#DownloadManagerDialog QTreeWidget::item {
    padding: 4px 2px;
    border-bottom: 1px solid rgba(43, 43, 69, 7%);
}
QDialog#DownloadManagerDialog QTreeWidget::item:selected {
    background: rgba(110, 130, 255, 24%);
    color: #1a1a2e;
}
QDialog#DownloadManagerDialog QHeaderView {
    background-color: #edf1ff;
    border: none;
}
QDialog#DownloadManagerDialog QHeaderView::section {
    background-color: #e4eaff;
    color: #232a4d;
    border: none;
    border-right: 1px solid rgba(80, 110, 200, 14%);
    border-bottom: 1px solid rgba(80, 110, 200, 22%);
    padding: 8px 10px;
    font-weight: 600;
}
QDialog#DownloadManagerDialog QProgressBar {
    background: rgba(43, 43, 69, 5%);
    border: 1px solid rgba(120, 150, 255, 26%);
    border-radius: 7px;
    color: #2b2b45;
    text-align: center;
    font-size: 11px;
    min-height: 14px;
    max-height: 14px;
}
QDialog#DownloadManagerDialog QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #35c2ff);
}

/* 设置页路径输入框：浅色主题跟随玻璃卡片 */
QDialog#SettingsDialog QLineEdit {
    background: rgba(255, 255, 255, 88%);
    border: 1px solid rgba(120, 150, 255, 28%);
    border-radius: 8px;
    padding: 4px 8px;
    color: #2b2b45;
    selection-background-color: rgba(110, 92, 255, 35%);
    selection-color: #1a1a2e;
}
QDialog#SettingsDialog QLineEdit:focus {
    background: #ffffff;
    border: 1px solid rgba(120, 150, 255, 65%);
}

/* 快捷键设置：浅色梦幻玻璃面板，保证表格文字与表头对比度。 */
QDialog#ShortcutSettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fdfcff,
                                stop:1 #eef3ff);
}
QDialog#ShortcutSettingsDialog QLabel {
    color: #3a3f63;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts {
    background: rgba(255, 255, 255, 88%);
    alternate-background-color: rgba(245, 248, 255, 92%);
    border: 1px solid rgba(120, 150, 255, 26%);
    border-radius: 12px;
    color: #2b2b45;
    gridline-color: rgba(120, 150, 255, 12%);
    selection-background-color: rgba(110, 92, 255, 22%);
    selection-color: #1a1a2e;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts::item {
    color: #2b2b45;
    padding: 3px 8px;
    border: none;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts::item:selected {
    color: #1a1a2e;
    background: rgba(110, 92, 255, 24%);
}
QDialog#ShortcutSettingsDialog QHeaderView::section {
    background-color: #e4eaff;
    color: #232a4d;
    border: none;
    border-right: 1px solid rgba(80, 110, 200, 14%);
    border-bottom: 1px solid rgba(80, 110, 200, 22%);
    padding: 7px 8px;
    font-weight: 600;
}
QDialog#ShortcutSettingsDialog QKeySequenceEdit,
QDialog#ShortcutSettingsDialog QLineEdit {
    background: rgba(255, 255, 255, 92%);
    border: 1px solid rgba(120, 150, 255, 28%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #2b2b45;
    selection-background-color: rgba(110, 92, 255, 35%);
    selection-color: #1a1a2e;
}
QDialog#ShortcutSettingsDialog QKeySequenceEdit:focus,
QDialog#ShortcutSettingsDialog QLineEdit:focus {
    background: #ffffff;
    border: 1px solid rgba(120, 150, 255, 65%);
}
QDialog#ShortcutSettingsDialog QToolButton {
    background: rgba(255, 255, 255, 94%);
    border: 1px solid rgba(120, 150, 255, 24%);
    border-radius: 8px;
    color: #2b2b45;
    padding: 4px 10px;
}
QDialog#ShortcutSettingsDialog QToolButton:hover {
    background: rgba(225, 235, 255, 96%);
    border-color: rgba(120, 150, 255, 55%);
}
