/* ============================================================
   主题：深色梦幻（dark dream）
   深空渐变底 + 半透明玻璃面板 + 青紫渐变强调
   只使用 Qt 样式表支持的属性
   ============================================================ */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #dfe4ff;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0    #070716,
                                stop:0.35 #120c2b,
                                stop:0.7  #0c1830,
                                stop:1    #060a16);
}

QWidget#centralwidget {
    background: transparent;
}

/* ------------------------------------------------ 玻璃面板 */
QFrame#panelSidebar,
QFrame#panelStage,
QFrame#panelTransport {
    background: rgba(255, 255, 255, 4%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 18px;
}

QFrame#panelStage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a20,
                                stop:1 #101a33);
    border: 1px solid rgba(150, 200, 255, 18%);
}

/* 侧栏做成浮层时压在画面上，底色要更实才看得清；回布局时保持原来的淡玻璃 */
QFrame#panelSidebar[floating="true"] {
    background: rgba(14, 16, 36, 90%);
}

/* 搜索分页条与结果列表分开，避免最后一行贴着翻页按钮像被压住 */
QFrame#frame_searchPager {
    border: none;
    border-top: 1px solid rgba(160, 190, 255, 18%);
    background: transparent;
}

QFrame#panelTransport {
    background: rgba(20, 22, 48, 55%);
    border: 1px solid rgba(160, 190, 255, 16%);
}

/* 全屏时控制条压在视频上，底色要比普通浮层更实，保证文字和进度条可读 */
QFrame#panelTransport[fullscreen="true"] {
    background: rgba(12, 14, 32, 92%);
    border: 1px solid rgba(160, 190, 255, 34%);
    border-radius: 18px;
}

/* ------------------------------------------------ 文字层级 */
/* 品牌头下的渐变细线 */
QFrame#brandLine {
    border: none;
    border-radius: 1px;
    min-height: 2px;
    max-height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0    rgba(142, 242, 255, 90%),
                                stop:0.45 rgba(123, 91, 255, 80%),
                                stop:1    rgba(142, 242, 255, 0%));
}

QLabel#label_searchTitle,
QLabel#label_playlistTitle {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
    padding-left: 4px;
}

QLabel#label_status {
    color: rgba(205, 215, 255, 80%);
    font-size: 12px;
}

QLabel#label_time {
    color: rgba(180, 230, 255, 85%);
    font-size: 12px;
}

QLabel#label_volume {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
}

/* ------------------------------------------------ 输入类 */
QLineEdit#edit_search {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 19px;
    padding: 4px 14px;
    color: #eef2ff;
    selection-background-color: #6d5cff;
    selection-color: #ffffff;
}

QLineEdit#edit_search:hover {
    border: 1px solid rgba(150, 195, 255, 40%);
}

QLineEdit#edit_search:focus {
    background: rgba(255, 255, 255, 10%);
    border: 1px solid rgba(120, 200, 255, 75%);
}

QComboBox {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 10px;
    padding: 4px 10px;
    min-height: 26px;
    color: #e6ecff;
}

QComboBox:hover {
    border: 1px solid rgba(150, 195, 255, 45%);
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 25%);
    border-radius: 10px;
    padding: 4px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 45%);
}

/* 下拉弹层上下滚动器默认带浅色底板，会在深色弹层底部留下白条 */
QComboBoxPrivateScroller {
    background: transparent;
    border: none;
    min-height: 0;
    max-height: 0;
}

/* 搜索筛选行宽度紧张：三个下拉并排时压缩内边距，避免只剩一两个字可见 */
QComboBox#combo_searchType,
QComboBox#combo_searchSource,
QComboBox#combo_searchQuality {
    padding: 2px 18px 2px 5px;
    border-radius: 8px;
    min-height: 24px;
}

QComboBox#combo_searchType::drop-down,
QComboBox#combo_searchSource::drop-down,
QComboBox#combo_searchQuality::drop-down {
    width: 16px;
}

QListWidget#list_searchSuggestions {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 30%);
    border-radius: 10px;
    padding: 4px;
    color: #e6ecff;
    outline: none;
    selection-background-color: rgba(110, 92, 255, 45%);
}

QListWidget#list_searchSuggestions::item {
    padding: 7px 10px;
    border-radius: 8px;
}

QListWidget#list_searchSuggestions::item:hover,
QListWidget#list_searchSuggestions::item:selected {
    background: rgba(110, 92, 255, 30%);
    color: #ffffff;
}

/* ------------------------------------------------ 通用按钮 */
QPushButton {
    background: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 14px;
    padding: 6px 16px;
    min-height: 26px;
    color: #dfe4ff;
}

/* 源管理左侧 4 列紧凑按钮：收窄左右内边距，避免两字标签被裁 */
QPushButton#btn_add,
QPushButton#btn_duplicate,
QPushButton#btn_remove,
QPushButton#btn_addSite,
QPushButton#btn_import,
QPushButton#btn_export,
QPushButton#btn_example,
QPushButton#btn_refresh {
    padding: 2px 4px;
    min-height: 20px;
}

QPushButton:hover {
    background: rgba(130, 150, 255, 22%);
    border: 1px solid rgba(150, 200, 255, 55%);
}

QPushButton:pressed {
    background: rgba(110, 130, 255, 35%);
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 30%);
    border-color: rgba(255, 255, 255, 8%);
}

QPushButton#btn_search {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
    border: 1px solid rgba(180, 220, 255, 45%);
    border-radius: 19px;
    color: #ffffff;
    font-weight: 600;
    padding: 0;
}

/* 独立搜索窗口沿用主界面的深色梦幻底色，不再挤在侧栏里 */
QWidget#SearchWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0d1020,
                                stop:0.55 #12142c,
                                stop:1 #1a1230);
    color: #e6ecff;
}

QLabel#label_searchStatus,
QLabel#label_downloadStatus {
    color: rgba(180, 230, 255, 85%);
    font-size: 12px;
    padding: 2px 4px;
}

QLabel#label_searchHint {
    color: rgba(205, 220, 255, 45%);
    padding: 12px 6px;
}

/* 搜索翻页按钮改成纯图标，固定紧凑尺寸 */
QPushButton#btn_searchPrev,
QPushButton#btn_searchNext {
    min-width: 30px;
    max-width: 30px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 13px;
    padding: 0;
}

QPushButton#btn_search:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8272ff,
                                stop:1 #4acdff);
}

QPushButton#btn_play {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
    border: 1px solid rgba(200, 235, 255, 60%);
    color: #ffffff;
    font-weight: 700;
    padding: 0;
}

QPushButton#btn_play:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #9179ff,
                                stop:1 #57d8ff);
}

QPushButton#btn_stop,
QPushButton#btn_mode,
QPushButton#btn_fullscreen,
QPushButton#btn_downloads,
QPushButton#btn_openSearch,
QPushButton#btn_prev,
QPushButton#btn_next,
QPushButton#btn_seekBack,
QPushButton#btn_seekForward {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
}

/* 侧栏底部按钮改成纯图标，固定方形，悬停提示由代码写入 */
QPushButton#btn_settings {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
    color: rgba(200, 220, 255, 70%);
}

/* ------------------------------------------------ 列表 */
QListView,
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    color: #d8ddff;
}

QListView::item,
QListWidget::item {
    padding: 7px 10px;
    border-radius: 10px;
    margin: 2px 4px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: rgba(255, 255, 255, 7%);
}

QListView::item:selected,
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(110, 92, 255, 50%),
                                stop:1 rgba(40, 180, 255, 22%));
    color: #ffffff;
}

/* ------------------------------------------------ 自绘容器 */
QWidget#videoStage {
    background: transparent;
}

/* ------------------------------------------------ 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget::tab-bar {
    left: 0;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 4%);
    color: rgba(215, 222, 255, 60%);
    padding: 7px 16px;
    border-radius: 12px;
    margin-right: 6px;
    min-width: 64px;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 9%);
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(110, 92, 255, 55%),
                                stop:1 rgba(40, 180, 255, 35%));
    color: #ffffff;
}

/* ------------------------------------------------ 滑块 */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 10%);
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
}

QSlider::add-page:horizontal {
    border-radius: 3px;
    background: rgba(255, 255, 255, 8%);
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #d8f6ff,
                                stop:1 #7fd0ff);
    border: 1px solid rgba(120, 200, 255, 85%);
}

QSlider#slider_volume::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}

QSlider#slider_volume::handle:horizontal {
    width: 11px;
    height: 11px;
    margin: -4px 0;
    border-radius: 6px;
}

/* 右侧竖排悬浮音量条：按钮只保留图标，滑块放进弹出面板 */
QPushButton#btn_volume {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
}

QFrame#volumePopup {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(34, 39, 74, 96%),
                                stop:1 rgba(15, 18, 38, 96%));
    border: 1px solid rgba(130, 180, 255, 55%);
    border-radius: 16px;
}

QLabel#label_volumeValue {
    color: #dceeff;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 8px;
    background: rgba(120, 170, 255, 14%);
}

QSlider#slider_volume::groove:vertical {
    width: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 22%);
    border: 1px solid rgba(140, 185, 255, 26%);
}

QSlider#slider_volume::sub-page:vertical {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
}

QSlider#slider_volume::add-page:vertical {
    border-radius: 4px;
    background: rgba(255, 255, 255, 8%);
}

QSlider#slider_volume::handle:vertical {
    width: 18px;
    height: 18px;
    margin: 0 -6px;
    border-radius: 9px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #e8f9ff,
                                stop:1 #7fd0ff);
    border: 1px solid rgba(150, 220, 255, 95%);
}

/* ------------------------------------------------ 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(150, 200, 255, 55%);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-width: 28px;
}

/* ------------------------------------------------ 菜单 / 提示 / 对话框 */
QMenu {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 25%);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(110, 92, 255, 45%);
}

QToolTip {
    background: #161433;
    color: #e6ecff;
    border: 1px solid rgba(150, 190, 255, 30%);
    border-radius: 6px;
    padding: 4px 8px;
}

/* 系统消息框：不单独上色会沿用系统浅色底 + 主题浅色字，直接看不清 */
QMessageBox {
    background: #101226;
}

QMessageBox QLabel {
    color: #dfe4ff;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 76px;
    padding: 4px 14px;
}

QDialog#SettingsDialog,
QDialog#SourceManagerDialog, QDialog#SourceProbeDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
}

/* 外部解析器配置是源管理里的二级弹窗：它没有进入 SettingsDialog 的滚动区，
   之前完全没命中任何对话框样式，会落回系统浅色底；深色主题下白底配浅色
   文字几乎不可读。这里补齐与源管理一致的背景、文字和卡片。 */
QDialog#SourceParserSettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
}

QDialog#SourceParserSettingsDialog QLabel {
    color: #cfd6ff;
    background: transparent;
}

QDialog#SourceParserSettingsDialog QLineEdit {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 45%);
}

QDialog#SourceParserSettingsDialog QLineEdit:focus {
    background: rgba(255, 255, 255, 10%);
    border: 1px solid rgba(150, 200, 255, 60%);
}

QDialog#SourceParserSettingsDialog QFrame#settingsCard {
    background: #15162b;
    border: 1px solid #29304c;
    border-radius: 14px;
}

/* 搜索源管理 / 探源窗口里的表单控件：与主界面保持同一套玻璃质感 */
QDialog#SourceManagerDialog QLineEdit,
QDialog#SourceProbeDialog QLineEdit,
QDialog#SourceManagerDialog QPlainTextEdit,
QDialog#SourceProbeDialog QPlainTextEdit,
QDialog#SourceManagerDialog QComboBox,
QDialog#SourceProbeDialog QComboBox {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 45%);
}

QDialog#SourceManagerDialog QLineEdit:focus,
QDialog#SourceProbeDialog QLineEdit:focus,
QDialog#SourceManagerDialog QPlainTextEdit:focus,
QDialog#SourceProbeDialog QPlainTextEdit:focus,
QDialog#SourceManagerDialog QComboBox:focus,
QDialog#SourceProbeDialog QComboBox:focus {
    border: 1px solid rgba(150, 200, 255, 60%);
}

QDialog#SourceManagerDialog QGroupBox,
QDialog#SourceProbeDialog QGroupBox {
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 12px;
    margin-top: 14px;
    padding: 6px 8px 4px 8px;
}

QDialog#SourceManagerDialog QGroupBox::title,
QDialog#SourceProbeDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #8ef2ff;
}

/* 探源结果表：默认 QTableWidget 会退回系统浅色底，必须显式覆盖表体与表头 */
QDialog#SourceProbeDialog QTableWidget#table_results {
    background: rgba(8, 12, 26, 88%);
    alternate-background-color: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    color: #dfe4ff;
    gridline-color: rgba(150, 190, 255, 16%);
    selection-background-color: rgba(110, 92, 255, 38%);
    selection-color: #ffffff;
}

QDialog#SourceProbeDialog QTableWidget#table_results::item {
    padding: 4px 6px;
    border: none;
}

QDialog#SourceProbeDialog QHeaderView::section {
    background-color: #202747;
    color: #eef2ff;
    border: none;
    border-right: 1px solid rgba(160, 190, 255, 20%);
    border-bottom: 1px solid rgba(160, 190, 255, 32%);
    padding: 5px 6px;
    font-weight: 600;
}

QDialog#SourceProbeDialog QTableCornerButton::section {
    background-color: #202747;
    border: none;
}

/* 主操作按钮禁用时不能继续显示成可点击的高亮按钮 */
QPushButton#btn_applyPrimary:disabled {
    background: rgba(110, 120, 160, 16%);
    border: 1px solid rgba(160, 180, 220, 20%);
    color: rgba(220, 230, 255, 45%);
}

QDialog#SourceManagerDialog QCheckBox,
QDialog#SourceProbeDialog QCheckBox {
    color: #dfe4ff;
}

/* 设置页的复选框、所有数值框也要跟主题，不能退回系统默认浅色 */
QCheckBox {
    color: #dfe4ff;
    spacing: 6px;
}

QSpinBox {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 10px;
    padding: 3px 8px;
    min-height: 26px;
    color: #e6ecff;
}

QSpinBox:hover {
    border: 1px solid rgba(150, 195, 255, 45%);
}

QDialog#SourceManagerDialog QLabel,
QDialog#SourceProbeDialog QLabel {
    color: #cfd6ff;
}

/* 源列表启用了交替行，默认交替底色在深色主题下是白色，偶数行会变成白底浅字 */
QDialog#SourceManagerDialog QListWidget#list_sources {
    alternate-background-color: rgba(255, 255, 255, 5%);
    color: #dfe4ff;
}

QDialog#SourceProbeDialog QListWidget {
    background: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 10px;
    color: #dfe4ff;
}

/* 表单在滚动区里，滚动区本身不能带白底 */
QDialog#SettingsDialog QScrollArea,
QDialog#SourceManagerDialog QScrollArea,
QDialog#SourceProbeDialog QScrollArea {
    background: transparent;
    border: none;
}

/* 滚动容器使用与对话框一致的底色。
   半透明卡片必须叠在不透明底色上才不会被“透明套透明”吃掉边框和背景。 */
QWidget#scroll_widget,
QWidget#scroll_bodyWidget,
QWidget#rightBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
}

QDialog#SettingsDialog QScrollArea QScrollBar:vertical,
QDialog#SourceManagerDialog QScrollArea QScrollBar:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar:vertical {
    background: rgba(255, 255, 255, 4%);
    width: 8px;
    border-radius: 4px;
}

QDialog#SettingsDialog QScrollArea QScrollBar::handle:vertical,
QDialog#SourceManagerDialog QScrollArea QScrollBar::handle:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar::handle:vertical {
    background: rgba(150, 190, 255, 45%);
    border-radius: 4px;
    min-height: 24px;
}

QLabel#label_sectionTitle {
    color: #8ef2ff;
    font-size: 13px;
    font-weight: 600;
}

QDialog#SettingsDialog QScrollArea QFrame#settingsCard {
    /* 滚动区里的半透明控件在透明父层上会被吃掉，改用与玻璃面板等效的不透明底色 */
    background: #15162b;
    border: 1px solid #29304c;
    border-radius: 14px;
}

QLabel#label_hint {
    color: rgba(205, 215, 255, 55%);
    font-size: 12px;
}

QLabel#label_error,
QPlainTextEdit#label_error {
    color: #ff9aa8;
    background: rgba(255, 96, 120, 8%);
    border: 1px solid rgba(255, 96, 120, 22%);
    border-radius: 10px;
    font-size: 12px;
}

QPushButton#btn_applyPrimary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
    border: 1px solid rgba(180, 220, 255, 45%);
    color: #ffffff;
    font-weight: 600;
    border-radius: 14px;
    padding: 7px 22px;
}

/* 下载管理器：独立非模态窗口，必须显式给暗色底，避免跟随系统白底导致白字不可读 */
QDialog#DownloadManagerDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
    color: #dfe4ff;
}
QDialog#DownloadManagerDialog QLabel {
    color: #dfe4ff;
    background: transparent;
}
QDialog#DownloadManagerDialog QTreeWidget {
    background: rgba(6, 10, 26, 82%);
    alternate-background-color: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(150, 180, 255, 22%);
    border-radius: 10px;
    color: #dfe4ff;
    outline: none;
}
QDialog#DownloadManagerDialog QTreeWidget::item {
    padding: 4px 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
}
QDialog#DownloadManagerDialog QTreeWidget::item:selected {
    background: rgba(110, 130, 255, 30%);
    color: #ffffff;
}
QDialog#DownloadManagerDialog QHeaderView {
    background-color: #151a32;
    border: none;
}
QDialog#DownloadManagerDialog QHeaderView::section {
    background-color: #202747;
    color: #eef2ff;
    border: none;
    border-right: 1px solid rgba(160, 190, 255, 20%);
    border-bottom: 1px solid rgba(160, 190, 255, 32%);
    padding: 8px 10px;
    font-weight: 600;
}
QDialog#DownloadManagerDialog QProgressBar {
    background: rgba(255, 255, 255, 7%);
    border: 1px solid rgba(150, 180, 255, 22%);
    border-radius: 7px;
    color: #dfe4ff;
    text-align: center;
    font-size: 11px;
    min-height: 14px;
    max-height: 14px;
}
QDialog#DownloadManagerDialog QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
}

/* 设置页路径输入框：暗色主题下必须显式给浅色文字，否则深底深字不可读 */
QDialog#SettingsDialog QLineEdit {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    padding: 4px 8px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 55%);
    selection-color: #ffffff;
}
QDialog#SettingsDialog QLineEdit:focus {
    background: rgba(255, 255, 255, 10%);
    border: 1px solid rgba(150, 200, 255, 60%);
}

/* 快捷键设置：深色梦幻玻璃面板。表格和输入框必须显式配色，
   否则 QTableWidget 会退回系统浅色底，叠加深色主题的浅色文字后不可读。 */
QDialog#ShortcutSettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
}
QDialog#ShortcutSettingsDialog QLabel {
    color: #cfd6ff;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts {
    background: rgba(255, 255, 255, 5%);
    alternate-background-color: rgba(255, 255, 255, 3%);
    border: 1px solid rgba(160, 190, 255, 16%);
    border-radius: 12px;
    color: #e6ecff;
    gridline-color: rgba(160, 190, 255, 10%);
    selection-background-color: rgba(110, 92, 255, 35%);
    selection-color: #ffffff;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts::item {
    color: #e6ecff;
    padding: 3px 8px;
    border: none;
}
QDialog#ShortcutSettingsDialog QTableWidget#table_shortcuts::item:selected {
    color: #ffffff;
    background: rgba(110, 92, 255, 40%);
}
QDialog#ShortcutSettingsDialog QHeaderView::section {
    background-color: #202747;
    color: #eef2ff;
    border: none;
    border-right: 1px solid rgba(160, 190, 255, 20%);
    border-bottom: 1px solid rgba(160, 190, 255, 32%);
    padding: 7px 8px;
    font-weight: 600;
}
QDialog#ShortcutSettingsDialog QKeySequenceEdit,
QDialog#ShortcutSettingsDialog QLineEdit {
    background: rgba(255, 255, 255, 7%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #eef2ff;
    selection-background-color: rgba(110, 92, 255, 55%);
    selection-color: #ffffff;
}
QDialog#ShortcutSettingsDialog QKeySequenceEdit:focus,
QDialog#ShortcutSettingsDialog QLineEdit:focus {
    background: rgba(255, 255, 255, 11%);
    border: 1px solid rgba(150, 200, 255, 65%);
}
QDialog#ShortcutSettingsDialog QToolButton {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(150, 190, 255, 20%);
    border-radius: 8px;
    color: #dfe4ff;
    padding: 4px 10px;
}
QDialog#ShortcutSettingsDialog QToolButton:hover {
    background: rgba(120, 170, 255, 18%);
    border-color: rgba(150, 200, 255, 45%);
}
