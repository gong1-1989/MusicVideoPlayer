/* ============================================================
   主题：深色梦幻（dark dream）
   深空渐变底 + 半透明玻璃面板 + 青紫渐变强调
   只使用 Qt 样式表支持的属性
   ============================================================ */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #dfe4ff;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0    #070716,
                                stop:0.35 #120c2b,
                                stop:0.7  #0c1830,
                                stop:1    #060a16);
}

QWidget#centralwidget {
    background: transparent;
}

/* ------------------------------------------------ 玻璃面板 */
QFrame#panelSidebar,
QFrame#panelStage,
QFrame#panelTransport,
QFrame#panelLyrics {
    background: rgba(255, 255, 255, 4%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 18px;
}

QFrame#panelStage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a20,
                                stop:1 #101a33);
    border: 1px solid rgba(150, 200, 255, 18%);
}

/* 侧栏做成浮层时压在画面上，底色要更实才看得清；回布局时保持原来的淡玻璃 */
QFrame#panelSidebar[floating="true"] {
    background: rgba(14, 16, 36, 90%);
}

QFrame#panelTransport {
    background: rgba(20, 22, 48, 55%);
    border: 1px solid rgba(160, 190, 255, 16%);
}

/* 歌词面板用实色底：渐隐遮罩必须与面板底色完全一致，否则会看出色块 */
QFrame#panelLyrics {
    background: #101226;
    border: 1px solid rgba(160, 190, 255, 16%);
    border-radius: 18px;
}

/* ------------------------------------------------ 文字层级 */
QLabel#label_brand {
    color: #8ef2ff;
    font-size: 15px;
    font-weight: 700;
}

/* 品牌头下的渐变细线 */
QFrame#brandLine {
    border: none;
    border-radius: 1px;
    min-height: 2px;
    max-height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0    rgba(142, 242, 255, 90%),
                                stop:0.45 rgba(123, 91, 255, 80%),
                                stop:1    rgba(142, 242, 255, 0%));
}

QLabel#label_searchTitle,
QLabel#label_lyricsTitle {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
    padding-left: 4px;
}

QLabel#label_status {
    color: rgba(205, 215, 255, 80%);
    font-size: 12px;
}

QLabel#label_time {
    color: rgba(180, 230, 255, 85%);
    font-size: 12px;
}

QLabel#label_volume {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
}

/* ------------------------------------------------ 输入类 */
QLineEdit#edit_search {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 19px;
    padding: 4px 14px;
    color: #eef2ff;
    selection-background-color: #6d5cff;
    selection-color: #ffffff;
}

QLineEdit#edit_search:hover {
    border: 1px solid rgba(150, 195, 255, 40%);
}

QLineEdit#edit_search:focus {
    background: rgba(255, 255, 255, 10%);
    border: 1px solid rgba(120, 200, 255, 75%);
}

QComboBox {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 10px;
    padding: 4px 10px;
    min-height: 26px;
    color: #e6ecff;
}

QComboBox:hover {
    border: 1px solid rgba(150, 195, 255, 45%);
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 25%);
    border-radius: 10px;
    padding: 4px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 45%);
}

/* ------------------------------------------------ 通用按钮 */
QPushButton {
    background: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 14px;
    padding: 6px 16px;
    min-height: 26px;
    color: #dfe4ff;
}

QPushButton:hover {
    background: rgba(130, 150, 255, 22%);
    border: 1px solid rgba(150, 200, 255, 55%);
}

QPushButton:pressed {
    background: rgba(110, 130, 255, 35%);
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 30%);
    border-color: rgba(255, 255, 255, 8%);
}

QPushButton#btn_search {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
    border: 1px solid rgba(180, 220, 255, 45%);
    border-radius: 19px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#btn_search:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8272ff,
                                stop:1 #4acdff);
}

QPushButton#btn_play {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
    border: 1px solid rgba(200, 235, 255, 60%);
    color: #ffffff;
    font-weight: 700;
    padding: 0;
}

QPushButton#btn_play:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #9179ff,
                                stop:1 #57d8ff);
}

QPushButton#btn_stop,
QPushButton#btn_mode,
QPushButton#btn_fullscreen,
QPushButton#btn_prev,
QPushButton#btn_next {
    border-radius: 15px;
    padding: 6px 10px;
}

/* 侧栏底部按钮内边距收窄，避免窄侧栏下文字被裁 */
QPushButton#btn_settings {
    border-radius: 15px;
    padding: 6px 8px;
    color: rgba(200, 220, 255, 70%);
}

/* ------------------------------------------------ 列表 */
QListView,
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    color: #d8ddff;
}

QListView::item,
QListWidget::item {
    padding: 7px 10px;
    border-radius: 10px;
    margin: 2px 4px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: rgba(255, 255, 255, 7%);
}

QListView::item:selected,
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(110, 92, 255, 50%),
                                stop:1 rgba(40, 180, 255, 22%));
    color: #ffffff;
}

QListWidget#list_lrc {
    background: transparent;
    border: none;
    font-size: 13px;
    color: rgba(215, 225, 255, 55%);
}

QListWidget#list_lrc::item {
    padding: 6px 4px;
    background: transparent;
}

/* ------------------------------------------------ 自绘容器 */
QWidget#videoStage {
    background: transparent;
}

/* ------------------------------------------------ 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget::tab-bar {
    left: 0;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 4%);
    color: rgba(215, 222, 255, 60%);
    padding: 7px 16px;
    border-radius: 12px;
    margin-right: 6px;
    min-width: 64px;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 9%);
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(110, 92, 255, 55%),
                                stop:1 rgba(40, 180, 255, 35%));
    color: #ffffff;
}

/* ------------------------------------------------ 滑块 */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 10%);
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
}

QSlider::add-page:horizontal {
    border-radius: 3px;
    background: rgba(255, 255, 255, 8%);
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #d8f6ff,
                                stop:1 #7fd0ff);
    border: 1px solid rgba(120, 200, 255, 85%);
}

QSlider#slider_volume::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}

QSlider#slider_volume::handle:horizontal {
    width: 11px;
    height: 11px;
    margin: -4px 0;
    border-radius: 6px;
}

/* ------------------------------------------------ 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(150, 200, 255, 55%);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-width: 28px;
}

/* ------------------------------------------------ 菜单 / 提示 / 对话框 */
QMenu {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 25%);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(110, 92, 255, 45%);
}

QToolTip {
    background: #161433;
    color: #e6ecff;
    border: 1px solid rgba(150, 190, 255, 30%);
    border-radius: 6px;
    padding: 4px 8px;
}

/* 系统消息框：不单独上色会沿用系统浅色底 + 主题浅色字，直接看不清 */
QMessageBox {
    background: #101226;
}

QMessageBox QLabel {
    color: #dfe4ff;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 76px;
    padding: 4px 14px;
}

QDialog#SettingsDialog,
QDialog#SourceManagerDialog, QDialog#SourceProbeDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a1e,
                                stop:1 #101a33);
}

/* 搜索源管理 / 探源窗口里的表单控件：与主界面保持同一套玻璃质感 */
QDialog#SourceManagerDialog QLineEdit,
QDialog#SourceProbeDialog QLineEdit,
QDialog#SourceManagerDialog QPlainTextEdit,
QDialog#SourceProbeDialog QPlainTextEdit,
QDialog#SourceManagerDialog QComboBox,
QDialog#SourceProbeDialog QComboBox {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(150, 190, 255, 22%);
    border-radius: 8px;
    padding: 3px 8px;
    color: #e6ecff;
    selection-background-color: rgba(110, 92, 255, 45%);
}

QDialog#SourceManagerDialog QLineEdit:focus,
QDialog#SourceProbeDialog QLineEdit:focus,
QDialog#SourceManagerDialog QPlainTextEdit:focus,
QDialog#SourceProbeDialog QPlainTextEdit:focus,
QDialog#SourceManagerDialog QComboBox:focus,
QDialog#SourceProbeDialog QComboBox:focus {
    border: 1px solid rgba(150, 200, 255, 60%);
}

QDialog#SourceManagerDialog QGroupBox,
QDialog#SourceProbeDialog QGroupBox {
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 12px;
    margin-top: 14px;
    padding: 6px 8px 4px 8px;
}

QDialog#SourceManagerDialog QGroupBox::title,
QDialog#SourceProbeDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #8ef2ff;
}

QDialog#SourceManagerDialog QCheckBox,
QDialog#SourceProbeDialog QCheckBox {
    color: #dfe4ff;
}

QDialog#SourceManagerDialog QLabel,
QDialog#SourceProbeDialog QLabel {
    color: #cfd6ff;
}

QDialog#SourceProbeDialog QListWidget {
    background: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 10px;
    color: #dfe4ff;
}

/* 表单在滚动区里，滚动区本身不能带白底 */
QDialog#SourceManagerDialog QScrollArea,
QDialog#SourceProbeDialog QScrollArea {
    background: transparent;
    border: none;
}

QDialog#SourceManagerDialog QScrollArea > QWidget > QWidget,
QDialog#SourceProbeDialog QScrollArea > QWidget > QWidget {
    background: transparent;
}

QDialog#SourceManagerDialog QScrollArea QScrollBar:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar:vertical {
    background: rgba(255, 255, 255, 4%);
    width: 8px;
    border-radius: 4px;
}

QDialog#SourceManagerDialog QScrollArea QScrollBar::handle:vertical,
QDialog#SourceProbeDialog QScrollArea QScrollBar::handle:vertical {
    background: rgba(150, 190, 255, 45%);
    border-radius: 4px;
    min-height: 24px;
}

QLabel#label_sectionTitle {
    color: #8ef2ff;
    font-size: 13px;
    font-weight: 600;
}

QFrame#settingsCard {
    background: rgba(255, 255, 255, 4%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 14px;
}

QLabel#label_hint {
    color: rgba(205, 215, 255, 55%);
    font-size: 12px;
}

QLabel#label_error,
QPlainTextEdit#label_error {
    color: #ff9aa8;
    background: rgba(255, 96, 120, 8%);
    border: 1px solid rgba(255, 96, 120, 22%);
    border-radius: 10px;
    font-size: 12px;
}

QPushButton#btn_applyPrimary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
    border: 1px solid rgba(180, 220, 255, 45%);
    color: #ffffff;
    font-weight: 600;
    border-radius: 14px;
    padding: 7px 22px;
}
