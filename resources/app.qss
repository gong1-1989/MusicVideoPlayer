/* ------------------------------------------------------------------
   NEBULA PLAYER · 深色梦幻主题
   思路：深空渐变底 → 半透明玻璃面板 → 青紫渐变强调色 → 大圆角与柔光
   只使用 Qt 样式表支持的属性，避免不生效的写法
------------------------------------------------------------------ */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #dfe4ff;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0    #070716,
                                stop:0.35 #120c2b,
                                stop:0.7  #0c1830,
                                stop:1    #060a16);
}

QWidget#centralwidget {
    background: transparent;
}

/* ------------------------------------------------ 玻璃面板 */
QFrame#panelSidebar,
QFrame#panelStage,
QFrame#panelTransport,
QFrame#panelLyrics {
    background: rgba(255, 255, 255, 4%);
    border: 1px solid rgba(160, 190, 255, 14%);
    border-radius: 18px;
}

QFrame#panelStage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a0a20,
                                stop:1 #101a33);
    border: 1px solid rgba(150, 200, 255, 18%);
}

QFrame#panelTransport {
    background: rgba(20, 22, 48, 55%);
    border: 1px solid rgba(160, 190, 255, 16%);
}

/* ------------------------------------------------ 文字层级 */
QLabel#label_brand {
    color: #8ef2ff;
    font-size: 15px;
    font-weight: 700;
}

QLabel#label_searchTitle,
QLabel#label_lyricsTitle {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
    padding-left: 4px;
}

QLabel#label_status {
    color: rgba(205, 215, 255, 80%);
    font-size: 12px;
}

QLabel#label_time {
    color: rgba(180, 230, 255, 85%);
    font-size: 12px;
}

QLabel#label_volume {
    color: rgba(210, 220, 255, 45%);
    font-size: 12px;
}

/* ------------------------------------------------ 搜索框 */
QLineEdit#edit_search {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(140, 175, 255, 22%);
    border-radius: 19px;
    padding: 4px 14px;
    color: #eef2ff;
    selection-background-color: #6d5cff;
    selection-color: #ffffff;
}

QLineEdit#edit_search:hover {
    border: 1px solid rgba(150, 195, 255, 40%);
}

QLineEdit#edit_search:focus {
    background: rgba(255, 255, 255, 10%);
    border: 1px solid rgba(120, 200, 255, 75%);
}

/* ------------------------------------------------ 通用按钮 */
QPushButton {
    background: rgba(255, 255, 255, 5%);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 14px;
    padding: 6px 16px;
    min-height: 26px;
    color: #dfe4ff;
}

QPushButton:hover {
    background: rgba(130, 150, 255, 22%);
    border: 1px solid rgba(150, 200, 255, 55%);
}

QPushButton:pressed {
    background: rgba(110, 130, 255, 35%);
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 30%);
    border-color: rgba(255, 255, 255, 8%);
}

QPushButton#btn_search {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6d5cff,
                                stop:1 #22b8ff);
    border: 1px solid rgba(180, 220, 255, 45%);
    border-radius: 19px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#btn_search:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8272ff,
                                stop:1 #4acdff);
}

QPushButton#btn_play {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
    border: 1px solid rgba(200, 235, 255, 60%);
    color: #ffffff;
    font-weight: 700;
    padding: 0;
}

QPushButton#btn_play:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #9179ff,
                                stop:1 #57d8ff);
}

QPushButton#btn_stop,
QPushButton#btn_mode,
QPushButton#btn_fullscreen,
QPushButton#btn_prev,
QPushButton#btn_next {
    border-radius: 15px;
    padding: 6px 14px;
}

/* ------------------------------------------------ 列表 */
QListView,
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    color: #d8ddff;
}

QListView::item,
QListWidget::item {
    padding: 7px 10px;
    border-radius: 10px;
    margin: 2px 4px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: rgba(255, 255, 255, 7%);
}

QListView::item:selected,
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(110, 92, 255, 50%),
                                stop:1 rgba(40, 180, 255, 22%));
    color: #ffffff;
}

QListWidget#list_lrc {
    font-size: 13px;
}

QListWidget#list_lrc::item {
    padding: 6px 4px;
}

/* ------------------------------------------------ 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget::tab-bar {
    left: 0;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 4%);
    color: rgba(215, 222, 255, 60%);
    padding: 7px 16px;
    border-radius: 12px;
    margin-right: 6px;
    min-width: 64px;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 9%);
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(110, 92, 255, 55%),
                                stop:1 rgba(40, 180, 255, 35%));
    color: #ffffff;
}

/* ------------------------------------------------ 滑块 */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 10%);
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7b5bff,
                                stop:1 #29c6ff);
}

QSlider::add-page:horizontal {
    border-radius: 3px;
    background: rgba(255, 255, 255, 8%);
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #d8f6ff,
                                stop:1 #7fd0ff);
    border: 1px solid rgba(120, 200, 255, 85%);
}

QSlider#slider_volume::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}

QSlider#slider_volume::handle:horizontal {
    width: 11px;
    height: 11px;
    margin: -4px 0;
    border-radius: 6px;
}

/* ------------------------------------------------ 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(150, 200, 255, 55%);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(150, 175, 255, 30%);
    border-radius: 4px;
    min-width: 28px;
}

/* ------------------------------------------------ 菜单与提示 */
QMenu {
    background: #14122e;
    border: 1px solid rgba(150, 190, 255, 25%);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(110, 92, 255, 45%);
}

QToolTip {
    background: #161433;
    color: #e6ecff;
    border: 1px solid rgba(150, 190, 255, 30%);
    border-radius: 6px;
    padding: 4px 8px;
}
